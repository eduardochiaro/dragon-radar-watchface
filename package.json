{
  "name": "dragon-radar-watchface",
  "author": "Eduardo Chiaro",
  "version": "1.0.0",
  "keywords": ["pebble-app"],
  "private": true,
  "dependencies": {},
  "scripts": {
    "build": "pebble build",
    "clean": "pebble clean",
    "emulator": "npm run clean && npm run build && pebble install --emulator ",
    "phone": "npm run clean && npm run build && pebble install --phone",
    "config": "pebble emu-app-config --emulator",
    "logs": "pebble logs --emulator",
    "tap": "pebble emu-tap --direction y+ --emulator"
  },
  "pebble": {
    "displayName": "Dragon Radar",
    "uuid": "2c2b2313-8f47-45cb-a3ff-6c2c9d406848",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "dummy"
    ],
    "resources": {
      "media": [
        {
          "menuIcon": "true",
          "type": "png",
          "name": "MENU_ICON",
          "file": "menu.png"
        }
      ]
    }
  }
}
